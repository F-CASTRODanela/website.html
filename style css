body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #ffe3ea;
}

.header {
  background: #f9b5c7;
  padding: 30px;
  position: relative;
  text-align: center;
}

.home,
.page2,
.page3 {
  position: absolute;
  top: 20px;
  text-decoration: none;
  color: black;
  font-weight: bold;
  font-size: 18px;
}

.home { left: 20px; }
.page2 { left: 90px; }
.page3 { left: 170px; }

h1 {
  margin: 0;
  margin-top: 30px;
}

.content {
  padding: 40px;
  position: relative;
}

.image {
  position: absolute;
  right: 0;
  top: 0;
}

.image img {
  width: 150px;
  height: 150px;
}

h2 {
  margin-top: 0;
}

p {
  width: 100%;
  line-height: 1.6;
  text-align: center;
  margin: 0 auto 16px;
}
